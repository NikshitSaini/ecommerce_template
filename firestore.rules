rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check if caller owns a store ─────────────────────────────────
    function isStoreOwner(storeId) {
      return request.auth != null
        && (get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid
            || get(/databases/$(database)/documents/stores/$(storeId)/users/$(request.auth.uid)).data.role == 'admin');
    }

    // ── Helper: check if caller is a super admin ──────────────────────────────
    function isSuperAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
           == 'super_admin';
    }

    // ── SaaS-level user profiles ──────────────────────────────────────────────
    // Each user can only read/write their own profile. Super admin can read all.
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isSuperAdmin());
      allow write: if request.auth != null
        && (request.auth.uid == userId || isSuperAdmin());
    }

    // ── Store documents (skin, config, domain) ────────────────────────────────
    // Public reads so storefronts can load the skin without any auth.
    // Only the verified owner of THIS store (or super admin) can write.
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ── Products subcollection ────────────────────────────────────────────────
    // Anyone can read products for the storefront.
    // Only the store owner (or super admin) can mutate products.
    match /stores/{storeId}/products/{productId} {
      allow read: if true;
      allow write: if isStoreOwner(storeId) || isSuperAdmin();
    }

    // ── Orders subcollection ──────────────────────────────────────────────────
    // Shoppers read their own orders. Store owner reads all orders.
    // Shoppers create; only store owner can update order status.
    match /stores/{storeId}/orders/{orderId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || isStoreOwner(storeId)
            || isSuperAdmin());
      allow create: if request.auth != null;
      allow update: if isStoreOwner(storeId) || isSuperAdmin();
      allow delete: if isStoreOwner(storeId) || isSuperAdmin();
    }

    // ── Users subcollection (Admins & Shoppers) ──────────────────────────────
    // Shoppers can read/write their own user profile within a store.
    // Store owner can read/write all users.
    match /stores/{storeId}/users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || isStoreOwner(storeId)
            || isSuperAdmin());
      allow write: if request.auth != null
        && (request.auth.uid == uid || isSuperAdmin() || isStoreOwner(storeId));
    }

    // ── Coupons subcollection ─────────────────────────────────────────────────
    // Public reads so checkout can validate coupon codes.
    // Only store owner or super admin can create/delete coupons.
    match /stores/{storeId}/coupons/{couponId} {
      allow read: if true;
      allow write: if isStoreOwner(storeId) || isSuperAdmin();
    }

    // ── Brands subcollection ──────────────────────────────────────────────────
    match /stores/{storeId}/brands/{brandId} {
      allow read: if true;
      allow write: if isStoreOwner(storeId) || isSuperAdmin();
    }

    // ── Categories subcollection ──────────────────────────────────────────────
    match /stores/{storeId}/categories/{categoryId} {
      allow read: if true;
      allow write: if isStoreOwner(storeId) || isSuperAdmin();
    }

    // ── Banners subcollection ─────────────────────────────────────────────────
    match /stores/{storeId}/banners/{bannerId} {
      allow read: if true;
      allow write: if isStoreOwner(storeId) || isSuperAdmin();
    }

    // ── Announcements subcollection ───────────────────────────────────────────
    match /stores/{storeId}/announcements/{announcementId} {
      allow read: if true;
      allow write: if isStoreOwner(storeId) || isSuperAdmin();
    }

    // ── Carts subcollection ───────────────────────────────────────────────────
    match /stores/{storeId}/carts/{cartId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isStoreOwner(storeId) || isSuperAdmin());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isStoreOwner(storeId) || isSuperAdmin());
    }
  }
}
